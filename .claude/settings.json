{
  "autoMemoryEnabled": true,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(docker compose down -v *)",
      "Bash(rm -rf *)",
      "Bash(find * -delete)"
    ]
  }
}
